# ---- TeamZero Cloud config ----
# Copy this file to ".env" and fill in the values. Nothing here is sent to buyers;
# it's the OWNER's config. Buyers just sign up and pay — they set up nothing.

# The ONE key that powers the AI for every buyer (server-side only, never exposed).
# Get it at https://console.anthropic.com  -> API keys.
ANTHROPIC_API_KEY=

# Models — split by task to minimize cost:
#   TEAMZERO_MODEL       = research/prospecting (needs web + reasoning) — Sonnet.
#   TEAMZERO_DRAFT_MODEL = writing emails (simple, high-volume) — Haiku, 3x cheaper.
TEAMZERO_MODEL=claude-sonnet-5
TEAMZERO_DRAFT_MODEL=claude-haiku-4-5

# Secret used to sign login cookies. Set to any long random string.
SESSION_SECRET=change-me-to-a-long-random-string

# ---- Stripe billing (buyers pay to use it) ----
# From https://dashboard.stripe.com  -> Developers -> API keys / Webhooks / Products.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
# The public URL of your deployed site (used for Stripe redirects). No trailing slash.
PUBLIC_URL=http://localhost:8090

# Accounts that get the product FREE (you the creator, plus any demo/comped
# accounts). Comma-separated emails. These bypass billing; everyone else pays.
OWNER_EMAILS=you@youremail.com

# ---- System mailbox (password resets + "your leads are ready" digests) ----
# The mailbox TeamZero itself sends from. Gmail: use an App Password.
# If unset, password-reset emails and morning digests are disabled.
SYSTEM_SMTP_USER=
SYSTEM_SMTP_PASS=
SYSTEM_SMTP_HOST=smtp.gmail.com
SYSTEM_SMTP_FROM_NAME=TeamZero

# ---- Optional: Apollo email verification ----
# When set, PROSPECTOR verifies the emails it finds via Apollo (paid plan needed
# for API access). Leave blank to keep smart pattern-guessed emails.
# Get it at https://app.apollo.io -> Settings -> Integrations -> API.
APOLLO_API_KEY=

# ---- Dev / local testing ----
# When set to 1, new accounts are unlocked without paying (for local testing).
# LEAVE UNSET / 0 in production so billing is enforced.
DEV_UNLOCK=1
# When ANTHROPIC_API_KEY is empty AND this is 1, the agents fall back to the
# local `claude` CLI (freedom-engine style) so you can run without an API key
# on your own machine. In production you set ANTHROPIC_API_KEY and this is ignored.
ALLOW_CLI_FALLBACK=1

PORT=8090
